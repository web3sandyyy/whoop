# Public URL of the app, no trailing slash (http://localhost:3000 locally)
APP_URL=https://your-app.vercel.app

# Long random string: `openssl rand -base64 32`
SESSION_SECRET=

# Supabase → Project settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# developer.whoop.com → your app
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
